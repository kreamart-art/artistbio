# Vereist: jouw Anthropic API-sleutel (blijft uitsluitend serverside).
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel: overschrijf het standaardmodel.
# Standaard: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vereist (vanaf fase 1): Neon Postgres connection string.
# Krijg je op https://console.neon.tech → project → "Connection string"
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vereist (vanaf fase 1): NextAuth secret. Genereer met: openssl rand -base64 32
AUTH_SECRET=

# Vereist (vanaf fase 1): NextAuth basis-URL (in productie de echte domeinnaam).
AUTH_URL=http://localhost:5260

# Vereist (vanaf fase 1): Resend API key voor magic-link e-mails.
# Krijg je op https://resend.com/api-keys
AUTH_RESEND_KEY=

# Optioneel: afzender-adres voor magic links. Standaard onboarding@resend.dev (testdomein van Resend).
# Voor productie: gebruik een eigen geverifieerd domein, bv. "ArtistBio <hi@jouwdomein.nl>".
EMAIL_FROM="ArtistBio <onboarding@resend.dev>"

# Vereist (vanaf fase 3): Stripe API-sleutel in test-modus.
# Krijg je op https://dashboard.stripe.com/test/apikeys → "Secret key" (begint met sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# Vereist (vanaf fase 4): comma-separated admin-e-mailadressen. Krijgen toegang
# tot /admin om invite-codes aan te maken voor het collectief.
ADMIN_EMAILS=

# Optioneel: comma-separated lijst e-mailadressen van het artnomad-collectief.
# Deze gebruikers krijgen automatisch credits + de collectief-vlag zodra ze
# voor het eerst inloggen — geen invite-code nodig.
COLLECTIVE_EMAILS=

# Optioneel: hoeveel credits een collectief-lid bij eerste login krijgt.
# Default: 1. Wijzig naar bv. 5 of 15 als je gulhartiger wil zijn.
COLLECTIVE_INITIAL_CREDITS=1

# Vereist (vanaf fase 3): Stripe webhook signing secret.
# Lokaal: krijg je van `stripe listen --forward-to localhost:5260/api/stripe-webhook`
# In productie: aanmaken in Stripe dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
